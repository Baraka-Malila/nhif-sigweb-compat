{
    "manifest_version":  3,
    "name":  "NHIF SigWeb Loader",
    "version":  "1.1",
    "description":  "Injects Topaz SigWeb API into NHIF portal for signature pad support",
    "content_scripts":  [
                            {
                                "matches":  [
                                                "*://verification.nhif.or.tz/*"
                                            ],
                                "js":  [
                                           "injector.js"
                                       ],
                                "run_at":  "document_start"
                            }
                        ],
    "web_accessible_resources":  [
                                     {
                                         "resources":  [
                                                           "sigweb.js"
                                                       ],
                                         "matches":  [
                                                         "*://verification.nhif.or.tz/*"
                                                     ]
                                     }
                                 ],
    "key":  ""
}
